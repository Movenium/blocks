# Committed so a developer's global ~/.npmrc cannot weaken these.
# See OWASP CICD-SEC-03 (Dependency Chain Abuse).

# Do not run install scripts from dependencies. Blocks install-time code
# execution from any package in the transitive tree.
ignore-scripts=true

# New dependencies land exactly pinned instead of caret-ranged.
save-exact=true

# Run npm's advisory check on install. This is npm's default; it is explicit
# here so a global audit=false cannot turn it off.
audit=true

fund=false
